# 环境变量的示例文件

# 两个可选值：
# 1. fake 使用模拟模型
# 2. deepseek 使用 DeepSeek。具体走哪套接口由 DEEPSEEK_MODEL_PROVIDER 决定
TEXT_MODEL_PROVIDER=

# DeepSeek API key
DEEPSEEK_API_KEY=

# deepseek-flash 或 deepseek-v4-pro
DEEPSEEK_MODEL=

# LangChain 的 model_provider。可选值：openai、anthropic
# openai 使用 https://api.deepseek.com
# anthropic 使用 https://api.deepseek.com/anthropic
DEEPSEEK_MODEL_PROVIDER=

# 让模拟模型报错的方式
# 支持配置的值有：none、characters、scenes
FAKE_PLANNING_FAULT=none

# 模拟生成分镜的时候报错
# 支持配置的值有：none、duplicate_id、unknown_character、duration_mismatch
FAKE_STORYBOARD_FAULT=none